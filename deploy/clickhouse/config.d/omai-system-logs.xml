<!--
  ClickHouse's own log tables are MergeTree tables on the data volume and ship
  with no TTL. On 2026-09-11 they were ~80 GB of an 85 GB volume while Langfuse's
  data was ~3 GB (asynchronous_metric_log 22 GiB, text_log 18 GiB, metric_log
  5 GiB, trace_log 4 GiB, query_log 2.6 GiB, plus ~18 GiB of renamed leftovers).

  Pattern borrowed from Plausible CE (clickhouse/logs.xml in
  github.com/plausible/community-edition): keep the few tables worth having
  with a short TTL, remove the rest.

  THIS FILE IS THE SINGLE SOURCE OF TRUTH for which log tables exist. The boot
  guard (docker-entrypoint-initdb.d/10-omai-guard.sh) reads the remove="1"
  entries below and drops those tables, plus any renamed <name>_N generation,
  on every start; verify-local.sh reads the <ttl> entries to know which tables
  must exist. Editing this file is enough — no list to keep in sync.

  Why metric_log and query_metric_log are removed rather than kept short:
  they have ~1 400 and ~1 000 columns. Merging or TTL-rewriting a wide part of
  such a table needs several GiB for per-column streams, which under a 3 GiB
  server cap fails and is retried every ~2 s forever, pinning the server at the
  cap and killing ordinary queries — the exact freeze this config exists to
  prevent (reproduced during review). Railway metrics cover memory over time.

  Langfuse reads exactly one of these tables: system.query_log
  (packages/shared/src/server/clickhouse/queryTracking.ts polls it to track
  background-migration queries). Keep it.

  Tables the base config enables that are not listed here (backup_log,
  crash_log, blob_storage_log, s3queue_log, iceberg_metadata_log, ...) only
  receive rows on events Langfuse never triggers; verify-local.sh fails if any
  of them ever grows a TTL-less table with data.
-->
<clickhouse>
  <!-- Keep: what a human (or Langfuse) looks at. -->
  <query_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </query_log>
  <part_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </part_log>
  <error_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </error_log>

  <!-- Remove: high-volume diagnostics nobody consumes here. -->
  <text_log remove="1" />                 <!-- the server log duplicated into a table; the console log below replaces it -->
  <asynchronous_metric_log remove="1" />  <!-- thousands of gauges per second -->
  <metric_log remove="1" />               <!-- ~1 400 columns; see above -->
  <query_metric_log remove="1" />         <!-- ~1 000 columns, one row per second per running query -->
  <asynchronous_insert_log remove="1" />  <!-- one row per async-insert flush; Langfuse inserts everything async -->
  <trace_log remove="1" />                <!-- sampling profiler -->
  <query_thread_log remove="1" />
  <query_views_log remove="1" />
  <processors_profile_log remove="1" />
  <opentelemetry_span_log remove="1" />

  <!-- Server log: 'trace' to a file on the ephemeral disk is the packaged
       default, and that file does not survive a Railway restart. Log at
       'information' to the console as well so Railway keeps the last lines
       across a restart (measured: ~60 lines at startup, then near silence). -->
  <logger>
    <level>information</level>
    <console>1</console>
  </logger>
</clickhouse>
